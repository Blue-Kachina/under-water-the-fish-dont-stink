; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Under Water The Fish Don't Stink"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Controls="*res://scripts/controls.gd"
UISettings="*res://scripts/ui_settings.gd"
NetSession="*res://scripts/net/net_session.gd"
Sfx="*res://scripts/audio/sfx.gd"
Console="*res://scripts/ui/console.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/rider-plugin/plugin.cfg")

[physics]

common/physics_ticks_per_second=120
common/physics_interpolation=true
3d/physics_engine="Jolt Physics"

[rendering]

anti_aliasing/quality/msaa_3d=2

[shader_globals]

water_time={
"type": "float",
"value": 0.0
}
water_caustic_strength={
"type": "float",
"value": 0.0
}
water_caustic_scale={
"type": "float",
"value": 0.2
}
water_caustic_speed={
"type": "float",
"value": 1.0
}
water_caustic_fade_start={
"type": "float",
"value": 35.0
}
water_caustic_fade_end={
"type": "float",
"value": 100.0
}
water_caustic_split={
"type": "float",
"value": 1.0
}
water_surface_y={
"type": "float",
"value": 30.0
}
water_sun_dir={
"type": "vec3",
"value": Vector3(0.4, 0.84, 0.4)
}
water_kd={
"type": "vec3",
"value": Vector3(0.0, 0.0, 0.0)
}
water_bubble_color={
"type": "vec3",
"value": Vector3(0.1, 0.4, 0.6)
}
water_bubble_look={
"type": "vec3",
"value": Vector3(1.0, 0.35, 2.0)
}
water_mat_kelp={
"type": "vec4",
"value": Color(0, 0, 0, 0)
}
water_mat_kelp2={
"type": "vec4",
"value": Color(0, 0, 0, 0)
}
water_mat_coral={
"type": "vec4",
"value": Color(0, 0, 0, 0)
}
water_mat_rock={
"type": "vec4",
"value": Color(0, 0, 0, 0)
}
water_mat_sand={
"type": "vec4",
"value": Color(0, 0, 0, 0)
}
water_biome={
"type": "vec4",
"value": Color(0, 0, 0, 0)
}
water_rock_detail={
"type": "sampler2D",
"value": "res://textures/rock_detail.png"
}
terrain_vol={
"type": "sampler3D",
"value": ""
}
terrain_vol_origin={
"type": "vec4",
"value": Color(0, 0, 0, 0)
}
terrain_vol_size={
"type": "vec4",
"value": Color(1, 1, 1, 0)
}
terrain_shadow={
"type": "sampler2D",
"value": ""
}
terrain_shadow_rect={
"type": "vec4",
"value": Color(0, 0, 1, 1)
}
terrain_shadow_sun={
"type": "vec4",
"value": Color(0, 1, 0, 0)
}
terrain_light={
"type": "vec4",
"value": Color(0, 0, 0, 0)
}
terrain_light2={
"type": "vec4",
"value": Color(0, 0, 0, 0)
}
