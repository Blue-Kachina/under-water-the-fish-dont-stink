extends SceneTree
## Writes scripts/ui/setting_docs.gd: the doc comment (##) above each tuning
## export of the settings' sections, which the settings' detail pane shows.
## Exported games don't keep comments, hence the generated table. An export
## with no comment right after another export shares that one's (e.g.
## roam_radius / roam_height). Run it again after adding or rewording a
## comment:
##   Godot_console.exe --headless --path . --script res://tools/gen_setting_docs.gd

## Settings section -> the script(s) its exports are in (base classes too).
const SECTIONS := {
	"fish": ["res://scripts/fish_controller.gd"],
	"camera": ["res://scripts/follow_camera.gd"],
	"ball": ["res://scripts/ball_settings.gd"],
	"nature": ["res://scripts/nature_settings.gd"],
	"unnatural": ["res://scripts/unnatural/unnatural_settings.gd"],
	"powerups": ["res://scripts/unnatural/powerups/powerup_settings.gd"],
}
const OUT := "res://scripts/ui/setting_docs.gd"


func _init() -> void:
	var docs := {}
	for section: String in SECTIONS:
		for path: String in SECTIONS[section]:
			var found := _docs_in(FileAccess.get_file_as_string(path))
			for prop: String in found:
				docs["%s/%s" % [section, prop]] = found[prop]
	var lines := PackedStringArray([
		"class_name SettingDocs",
		"## Generated by tools/gen_setting_docs.gd: what each tuning export's doc",
		"## comment says, for the settings' detail pane. Don't edit by hand; reword the",
		"## comment and run the tool again.",
		"",
		"const DOCS := {",
	])
	var keys := docs.keys()
	keys.sort()
	for key: String in keys:
		lines.append("\t\"%s\": \"%s\"," % [key, String(docs[key]).c_escape()])
	lines.append("}")
	lines.append("")
	var out := FileAccess.open(OUT, FileAccess.WRITE)
	out.store_string("\n".join(lines))
	out.close()
	print("gen_setting_docs: %d descriptions -> %s" % [docs.size(), OUT])
	quit()


## Export name -> its doc comment, in one script's source.
func _docs_in(source: String) -> Dictionary:
	var docs := {}
	var pending := PackedStringArray()
	var last_doc := ""
	var after_export := false
	var annotation_waiting := false
	var var_regex := RegEx.create_from_string("\\bvar\\s+([A-Za-z_][A-Za-z0-9_]*)")
	for raw in source.split("\n"):
		var line := raw.strip_edges()
		if line.begins_with("##"):
			pending.append(line.trim_prefix("##").strip_edges())
			after_export = false
			continue
		var exporting := line.begins_with("@export") and not line.begins_with("@export_group") and not line.begins_with("@export_subgroup") \
				and not line.begins_with("@export_category")
		if exporting or (annotation_waiting and line.begins_with("var ")):
			var found := var_regex.search(line)
			if found == null:
				annotation_waiting = true  # the annotation's on a line of its own
				continue
			annotation_waiting = false
			var doc := _join(pending)
			if doc.is_empty() and after_export:
				doc = last_doc
			if not doc.is_empty():
				docs[found.get_string(1)] = doc
			last_doc = doc
			pending.clear()
			after_export = true
			continue
		pending.clear()
		annotation_waiting = false
		after_export = false
	return docs


## Comment lines as text: lines run together, a blank ## line starts a new paragraph.
func _join(lines: PackedStringArray) -> String:
	var paragraphs := PackedStringArray()
	var current := ""
	for line in lines:
		if line.is_empty():
			if not current.is_empty():
				paragraphs.append(current)
			current = ""
		else:
			current = line if current.is_empty() else current + " " + line
	if not current.is_empty():
		paragraphs.append(current)
	return "\n\n".join(paragraphs)
